    private void btnCalcActionPerformed(java.awt.event.ActionEvent evt) {  // ทำงานเมื่อกดปุ่มคำนวณ BMI/BMR/TDEE
        btnCalc.setEnabled(false);                        // ปิดปุ่มชั่วคราว
        try {
            double w = readNumber(txtWeight, "Weight", 20, 300);   // อ่านน้ำหนัก
            double h = readNumber(txtHeight, "Height", 100, 250);  // อ่านส่วนสูง (ซม.)
            double a = readNumber(txtAge, "Age", 10, 100);         // อ่านอายุ
            boolean male = cmbGender.getSelectedIndex() == 0;      // index 0 ของเพศ = ชาย (ค่าเป็น true)
            int activity = cmbActivity.getSelectedIndex();         // ระดับการออกกำลังกาย (index 0-4)

            double bmi = Calculations.bmi(w, h);          // BMI = น้ำหนัก ÷ ส่วนสูง(ม.)²
            double bmr = Calculations.bmr(w, h, a, male); // BMR ตามสูตร Mifflin-St Jeor
            double tdee = Calculations.tdee(bmr, activity);  // TDEE = BMR × ตัวคูณตามกิจกรรม
            double hm = h / 100.0;                        // แปลงส่วนสูงจากซม. เป็นเมตร

            lblResult.setText(String.format("BMI = %.1f\n"   // แสดง BMI 1 ตำแหน่งทศนิยม
                + "%s\n\n"                                // หมวดหมู่ BMI (ข้อความ)
                + "BMR (พลังงานขณะพัก): %.0f kcal/วัน\n"    // BMR
                + "TDEE (พลังงานที่ใช้ต่อวัน): %.0f kcal/วัน\n\n"  // TDEE
                + "น้ำหนักที่เหมาะสม: %.1f - %.1f กก.\n\n"  // ช่วงน้ำหนักปกติ (BMI 18.5-22.9)
                + "เป้าหมายแคลอรี่\n"
                + "• ลดน้ำหนัก: ~%.0f kcal/วัน\n"            // TDEE − 500
                + "• คงน้ำหนัก: ~%.0f kcal/วัน\n"            // TDEE
                + "• เพิ่มกล้ามเนื้อ: ~%.0f kcal/วัน\n\n"    // TDEE + 300
                + "BMR คำนวณด้วยสูตร Mifflin-St Jeor / เกณฑ์ BMI สำหรับคนเอเชีย",  // หมายเหตุวิธีคิด
                bmi, Calculations.bmiCategory(bmi),        // ค่าที่ใส่แทน %.1f และ %s
                bmr, tdee,                                 // ค่าที่ใส่แทน BMR และ TDEE
                18.5 * hm * hm, 22.9 * hm * hm,            // น้ำหนักต่ำสุด-สูงสุดที่เหมาะสม
                tdee - 500, tdee, tdee + 300));            // เป้าหมายแคลอรี่ 3 แบบ
        } catch (IllegalArgumentException ex) {javax.swing.JOptionPane.showMessageDialog(this, ex.getMessage());  // แจ้งข้อผิดพลาด
        } finally {btnCalc.setEnabled(true);}             // เปิดปุ่มคืน
    }

