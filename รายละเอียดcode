    private void setupWorkoutTab() {                      // ตั้งค่าการทำงานของแท็บตารางออกกำลังกาย
        buildPlans();                                     // สร้างข้อมูลแผนก่อน

        DefaultListModel<String> lm = new DefaultListModel<>();  // โมเดลสำหรับรายการวัน
        for (DayPlan p : plans) lm.addElement(p.day);     // ใส่ชื่อวันทั้ง 7 วันลงในโมเดล
        jList1.setModel(lm);                              // ผูกโมเดลกับ JList ทางซ้าย (jList1)
        jList1.setFixedCellHeight(40);                    // กำหนดความสูงแต่ละแถวเป็น 40 พิกเซล
        jList1.setSelectionMode(javax.swing.ListSelectionModel.SINGLE_SELECTION);  // เลือกได้ทีละ 1 วัน

        jTable1.setRowHeight(32);                         // ความสูงแต่ละแถวในตาราง 32 พิกเซล
        jTable1.setSelectionMode(javax.swing.ListSelectionModel.SINGLE_SELECTION); // เลือกได้ทีละ 1 แถว

        txtHow.setEnabled(true);                          // เปิดใช้งานช่องวิธีทำ
        txtHow.setEditable(false);                        // ห้ามพิมพ์แก้ไข (ใช้แสดงผลอย่างเดียว)
        txtHow.setLineWrap(true);                         // ตัดบรรทัดเมื่อข้อความยาวเกิน
        txtHow.setWrapStyleWord(true);                    // ตัดบรรทัดตามคำ ไม่ตัดกลางคำ

        jList1.addListSelectionListener(e -> {            // เมื่อผู้ใช้เลือกวันใหม่
            if (!e.getValueIsAdjusting())                 // รอจนการเลือกเสร็จ (ไม่ทำระหว่างลาก)
                showDay(jList1.getSelectedIndex()); });   // แสดงท่าของวันที่เลือก

        jTable1.getSelectionModel().addListSelectionListener(e -> {  // เมื่อผู้ใช้คลิกแถวในตาราง
            if (e.getValueIsAdjusting()) return;          // ข้ามถ้ายังกำลังเลือกอยู่
            int r = jTable1.getSelectedRow();             // index แถวที่เลือก (-1 ถ้าไม่มี)
            if (r >= 0 && currentRows != null && r < currentRows.size()) {  // ตรวจว่าแถวถูกต้อง
                String[] ex = currentRows.get(r);         // ดึงข้อมูลท่านั้นมา
                txtHow.setText(ex[0] + "\n" + ex[4]);     // แสดงชื่อท่า ขึ้นบรรทัดใหม่ แล้วตามด้วยวิธีทำ
                txtHow.setCaretPosition(0);}              // ย้ายเคอร์เซอร์ไปบนสุดของข้อความ
            else {txtHow.setText(""); }});                // ไม่มีแถวที่เลือก ให้ล้างข้อความ

        jList1.setSelectedIndex(0); }                     // เลือกวันแรก (จันทร์) เป็นค่าเริ่มต้น

    private void showDay(int idx) {                       // แสดงตารางของวันที่ index = idx
        if (idx < 0) return;                              // ถ้าไม่มีการเลือก (-1) ไม่ต้องทำอะไร
        currentRows = plans.get(idx).rows;                // เก็บรายการท่าของวันนั้นไว้ใช้ภายหลัง
        DefaultTableModel tm = (DefaultTableModel) jTable1.getModel();  // ดึงโมเดลของตาราง
        tm.setRowCount(0);                                // ลบแถวเดิมทั้งหมด
        for (String[] r : currentRows) { tm.addRow(new Object[]{r[0], r[1], r[2], r[3]});}  // เพิ่มแถวใหม่ (ไม่แสดงวิธีทำในตาราง)
        txtHow.setText("");                               // ล้างช่องวิธีทำ
        if (!currentRows.isEmpty()) {jTable1.setRowSelectionInterval(0, 0);}}  // เลือกแถวแรกอัตโนมัติ

    // ===================== ตรวจสอบตัวเลขจากช่องกรอก =====================
    private double readNumber(javax.swing.JTextField f, String name, double min, double max) {  // อ่านและตรวจตัวเลขจากช่องกรอก
        String text = f.getText().trim();                 // อ่านข้อความและตัดช่องว่างหน้าหลัง
        if (text.isEmpty()) {                             // ถ้าช่องว่าง
            f.requestFocusInWindow();                     // ให้โฟกัสที่ช่องนั้น
            throw new IllegalArgumentException("Please fill in \"" + name + "\""); }  // โยนข้อผิดพลาดพร้อมข้อความแจ้ง
        if (!text.matches("\\d+(\\.\\d+)?")) {            // ตรวจรูปแบบ: ต้องเป็นตัวเลขบวก (จำนวนเต็มหรือทศนิยม)
            f.requestFocusInWindow();                     // โฟกัสช่อง
            f.selectAll();                                // เลือกข้อความทั้งหมดให้แก้ไขได้ทันที
            throw new IllegalArgumentException("\"" + name + "\" must be a number.");}  // แจ้งว่าไม่ใช่ตัวเลข
        double v = Double.parseDouble(text);              // แปลงข้อความเป็นเลข double
        if (v < min) {                                    // ถ้าน้อยกว่าค่าต่ำสุด
            f.requestFocusInWindow();
            f.selectAll();
            throw new IllegalArgumentException(String.format("\"%s\" Too low (must not be less than %.0f)", name, min)); }
        if (v > max) {                                    // ถ้ามากกว่าค่าสูงสุด
            f.requestFocusInWindow();
            f.selectAll();
            throw new IllegalArgumentException(String.format( "\"%s\" Too high (must not exceed %.0f)", name, max));}
        return v;}                                        // ค่าผ่านการตรวจแล้ว คืนค่ากลับ

    @SuppressWarnings("unchecked")                        // ปิดคำเตือนเรื่องชนิดข้อมูล (NetBeans สร้างให้)
    private void btnBurnActionPerformed(java.awt.event.ActionEvent evt) {  // ทำงานเมื่อกดปุ่มคำนวณการเผาผลาญ
        btnBurn.setEnabled(false);                        // ปิดปุ่มชั่วคราว กันกดซ้ำ
        try {
            double w = readNumber(txtWeight2, "Weight", 20, 300);  // อ่านน้ำหนัก (20-300 กก.)
            double m = readNumber(txtMinutes, "Time", 1, 600);     // อ่านเวลา (1-600 นาที)
            int i = cmbSport.getSelectedIndex();          // index ของกีฬาที่เลือก

            double kcal = Calculations.kcalBurned(i, w, m);  // แคลอรี่ที่เผาผลาญ = MET × น้ำหนัก × ชั่วโมง
            double fatG = kcal / 7.7;                     // แปลงเป็นกรัมไขมัน (1 กรัมไขมัน ≈ 7.7 kcal)

            StringBuilder sb = new StringBuilder();       // ใช้สร้างข้อความผลลัพธ์ทีละส่วน
            sb.append(String.format("%s %.0f นาที\n", Calculations.SPORT_NAMES[i], m));  // ชื่อกีฬาและเวลา
            sb.append(String.format("เผาผลาญประมาณ %.0f kcal\n\n", kcal));               // แคลอรี่ที่เผาผลาญ
            sb.append(String.format("เทียบเท่าไขมันประมาณ %.0f กรัม\n", fatG));          // เทียบเป็นไขมัน
            sb.append(String.format("ค่า MET = %.1f\n\n", Calculations.SPORT_MET[i]));   // แสดงค่า MET

            sb.append("เทียบกับอาหาร\n");                 // หัวข้อเทียบกับอาหาร
            sb.append(String.format("• ข้าวสวย 1 จาน (~250 kcal): %.1f จาน\n", kcal / 250));  // เทียบข้าวสวย
            sb.append(String.format("• ชานมไข่มุก 1 แก้ว (~400 kcal): %.1f แก้ว\n\n", kcal / 400));  // เทียบชานมไข่มุก

            sb.append(String.format("เทียบทุกกิจกรรม (%.0f นาที)\n", m));  // หัวข้อเทียบทุกกิจกรรม
            for (int k = 0; k < Calculations.SPORT_NAMES.length; k++) {    // วนทุกกีฬา
                sb.append(String.format("• %s: %.0f kcal\n",               // ชื่อกีฬา + แคลอรี่ที่เผาผลาญ
                    Calculations.SPORT_NAMES[k], Calculations.kcalBurned(k, w, m)));}
        lblBurnResult.setText(sb.toString());             // แสดงผลลัพธ์บนป้ายข้อความ
        } catch (IllegalArgumentException ex) { javax.swing.JOptionPane.showMessageDialog(this, ex.getMessage());  // แจ้งข้อผิดพลาดด้วยกล่องข้อความ
        } finally {btnBurn.setEnabled(true);}             // เปิดปุ่มคืนเสมอ ไม่ว่าจะสำเร็จหรือไม่
    }

