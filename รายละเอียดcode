// ===== Calculations.java =====  (แยกเป็นอีกไฟล์ เพราะไฟล์หนึ่งมี package ได้แค่ครั้งเดียว)
package gui;                                              // แพ็กเกจเดียวกับ FitnessGUI

public class Calculations {                               // คลาสเก็บสูตรคำนวณล้วน ๆ แยกจาก GUI
    public static final String[] SPORT_NAMES = {         // ชื่อกีฬา (ลำดับต้องตรงกับ SPORT_MET)
        "เดินเร็ว", "วิ่ง (8 กม./ชม.)", "ปั่นจักรยาน", "ว่ายน้ำ",
        "เต้นแอโรบิก", "ยกน้ำหนัก", "โยคะ", "HIIT", "กระโดดเชือก", "แบดมินตัน"};
    public static final double[] SPORT_MET = {3.8, 8.3, 7.5, 6.0, 6.5, 5.0, 2.5, 8.0, 11.0, 5.5};  // ค่า MET ของแต่ละกีฬา (index ตรงกับชื่อ)

    public static final String[] HEART_ZONE_NAMES = {    // ชื่อโซนหัวใจ 5 โซน
        "โซน 1 (ฟื้นฟู)", "โซน 2 (เผาผลาญไขมัน)", "โซน 3 (แอโรบิก)",
        "โซน 4 (เกณฑ์ความทนทาน)", "โซน 5 (สูงสุด)"};
    public static final double[] HEART_ZONE_LO = {0.50, 0.60, 0.70, 0.80, 0.90};  // ขอบล่างของแต่ละโซน (% ของ HRR)
    public static final double[] HEART_ZONE_HI = {0.60, 0.70, 0.80, 0.90, 1.00};  // ขอบบนของแต่ละโซน (% ของ HRR)

    public static double bmi(double w, double h) {       // คำนวณ BMI
        double hm = h / 100.0;                            // แปลงส่วนสูงเป็นเมตร
        return w / (hm * hm);}                            // BMI = น้ำหนัก ÷ ส่วนสูง²

    public static double bmr(double w, double h, double a, boolean male) {  // คำนวณ BMR (Mifflin-St Jeor)
        double sexConstant;                               // ค่าคงที่ตามเพศ
        if (male) {sexConstant = 5;}                      // ชาย +5
        else { sexConstant = -161; }                      // หญิง −161
        return 10 * w + 6.25 * h - 5 * a + sexConstant;}  // BMR = 10w + 6.25h − 5a ± ค่าเพศ

    public static double tdee(double bmr, int activityIndex) {  // คำนวณ TDEE
        double[] mul = {1.2, 1.375, 1.55, 1.725, 1.9};   // ตัวคูณตามระดับกิจกรรม (นั่งเฉย ๆ → หนักมาก)
        return bmr * mul[activityIndex];}                 // TDEE = BMR × ตัวคูณที่เลือก

    public static String bmiCategory(double bmi) {       // แปลงค่า BMI เป็นหมวดหมู่ (เกณฑ์เอเชีย)
        if (bmi < 18.5) return "น้ำหนักต่ำกว่าเกณฑ์";       // ต่ำกว่า 18.5
        if (bmi < 23)   return "สมส่วน (ปกติ)";            // 18.5 - 22.9
        if (bmi < 25)   return "น้ำหนักเกิน";              // 23 - 24.9
        if (bmi < 30)   return "โรคอ้วนระดับ 1";            // 25 - 29.9
        return "โรคอ้วนระดับ 2"; }                         // 30 ขึ้นไป

    public static double kcalBurned(int sportIndex, double weight, double minutes) {  // คำนวณแคลอรี่ที่เผาผลาญ
        return SPORT_MET[sportIndex] * weight * (minutes / 60.0);}  // kcal = MET × น้ำหนัก × ชั่วโมง

    public static double[][] heartZones(double age, double restHR) {  // คำนวณช่วงชีพจรแต่ละโซน (สูตร Karvonen)
        double max = 220 - age;                           // ชีพจรสูงสุด
        double reserve = max - restHR;                    // HRR = ชีพจรสูงสุด − ชีพจรพัก
        double[][] zones = new double[HEART_ZONE_LO.length][2];  // ตารางเก็บ [โซน][ต่ำสุด, สูงสุด]
        for (int i = 0; i < HEART_ZONE_LO.length; i++) {  // วนทีละโซน
            zones[i][0] = restHR + HEART_ZONE_LO[i] * reserve;  // ขอบล่าง = ชีพจรพัก + % ล่าง × HRR
            zones[i][1] = restHR + HEART_ZONE_HI[i] * reserve;} // ขอบบน = ชีพจรพัก + % บน × HRR
        return zones; }                                   // คืนค่าทุกโซน
}                                                         // ปิดคลาส Calculations
