    private void btnHeartActionPerformed(java.awt.event.ActionEvent evt) {  // ทำงานเมื่อกดปุ่มคำนวณโซนหัวใจ
        btnHeart.setEnabled(false);                       // ปิดปุ่มชั่วคราว
        try {
            double a = readNumber(txtAgeHR, "Age", 10, 100);                    // อ่านอายุ (10-100 ปี)
            double r = readNumber(txtRestHR, "Resting Heart Rate", 30, 120);    // อ่านชีพจรขณะพัก (30-120 bpm)
            double max = 220 - a;                         // ชีพจรสูงสุดโดยประมาณ = 220 − อายุ
            if (max - r <= 0) { throw new IllegalArgumentException("Resting heart rate must be lower than maximum heart rate.");}  // ป้องกันค่าที่ไม่สมเหตุสมผล

            double[][] zones = Calculations.heartZones(a, r);  // คำนวณช่วงชีพจรทุกโซน

            StringBuilder sb = new StringBuilder();
            sb.append(String.format("อัตราการเต้นสูงสุด = %.0f bpm\n", max));  // แสดงชีพจรสูงสุด
            sb.append("(สูตร Karvonen: ชีพจรเป้าหมาย = ชีพจรพัก + %HRR × (สูงสุด − พัก))\n\n");  // อธิบายสูตร
            for (int i = 0; i < zones.length; i++) {      // วนแต่ละโซน
                sb.append(String.format("■ %s\n    %.0f - %.0f bpm (%.0f-%.0f%%)\n",  // ชื่อโซน ช่วง bpm และ %
                    Calculations.HEART_ZONE_NAMES[i], zones[i][0], zones[i][1],
                    Calculations.HEART_ZONE_LO[i] * 100, Calculations.HEART_ZONE_HI[i] * 100));}  // คูณ 100 แปลง 0.5 เป็น 50%
        lblHeartResult.setText(sb.toString());            // แสดงผลลัพธ์
        } catch (IllegalArgumentException ex) {javax.swing.JOptionPane.showMessageDialog(this, ex.getMessage());  // แจ้งข้อผิดพลาด
        } finally {btnHeart.setEnabled(true);}            // เปิดปุ่มคืน
    }

